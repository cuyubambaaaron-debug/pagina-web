/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/ia/codigo/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

/ia/descargas/*
  Content-Disposition: attachment
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache
