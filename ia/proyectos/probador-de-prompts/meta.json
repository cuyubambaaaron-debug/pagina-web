{
  "titulo": "Probador de prompts",
  "tipo": "Proyecto",
  "version": "1.0.0",
  "lenguaje": "Python",
  "licencia": "MIT",
  "fecha": "2026-10-25",
  "resumen": "Manda tus prompts a la API de OpenAI y guarda las respuestas reales en un documento. Es lo que usamos para decir «probados de verdad».",
  "archivos": [
    "README.md",
    "probar.py",
    "prompts.txt",
    "LICENSE"
  ],
  "declara": {
    "internet": [
      "api.openai.com"
    ],
    "variables": [
      "OPENAI_API_KEY"
    ],
    "lee": "prompts.txt",
    "escribe": "respuestas.md"
  }
}
